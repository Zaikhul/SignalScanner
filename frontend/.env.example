# ==============================================================================
# PEMINDAI AREA - FRONTEND CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env.local pada direktori frontend:
# cp .env.example .env.local
# atau pada Windows PowerShell:
# Copy-Item .env.example .env.local

# URL Backend API FastAPI (Default port 8000)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# Token autentikasi untuk akses API Backend (harus sama dengan API_AUTH_TOKEN di backend)
NEXT_PUBLIC_API_AUTH_TOKEN="signal-scanner-dev-token-2026"

# Token untuk komunikasi langsung dengan Collector Local Agent (harus sama dengan LOCAL_AGENT_TOKEN di collector)
NEXT_PUBLIC_LOCAL_COLLECTOR_TOKEN="signal-scanner-local-agent-token-2026"

# URL Collector Local Agent (Default port 8001)
NEXT_PUBLIC_COLLECTOR_URL="http://127.0.0.1:8001"
