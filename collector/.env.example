# ==============================================================================
# PEMINDAI AREA - COLLECTOR DAEMON CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env pada direktori collector:
# cp .env.example .env
# atau pada Windows PowerShell:
# Copy-Item .env.example .env

# Identitas Collector
COLLECTOR_ID="col_local_host_01"
COLLECTOR_NAME="Scanner Host Workstation"

# URL Backend FastAPI Gateway
BACKEND_URL="http://127.0.0.1:8000"

# Kunci Keamanan & Tenant Salt (Harus sama dengan backend)
SECRET_KEY="secret-signal-scanner-key-hmac-salt-change-in-prod"
TENANT_SALT="tenant_default_salt_2026"

# Konfigurasi Buffer Offline (SQLite)
BUFFER_DB_PATH="./collector_offline_buffer.db"
MAX_BUFFER_RECORDS=5000

# Interval Polling & Heartbeat (Detik / Milidetik)
HEARTBEAT_INTERVAL_SECONDS=5
DEFAULT_SAMPLE_INTERVAL_MS=500
