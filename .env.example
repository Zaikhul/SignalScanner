# ==============================================================================
# Signal Scanner - Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Generate strong, cryptographically secure secrets for production:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Replace all placeholder values below before starting containers.
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=production
PROJECT_NAME="Signal Scanner"

# --- Database (TimescaleDB / PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-database-password-min-16-chars
POSTGRES_DB=SignalScanner
# Host/port binding for Docker host access (set to 127.0.0.1 for local isolation)
TIMESCALEDB_BIND_IP=127.0.0.1

# --- Stream Broker (Redis) ---
STREAM_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_BIND_IP=127.0.0.1

# --- Backend API Security & Auth ---
# Cryptographic secret for session signing and cryptographic hashes
SECRET_KEY=replace-with-cryptographically-random-32-byte-hex-string
# API Authentication token for operator / admin / UI access
API_AUTH_TOKEN=replace-with-strong-api-bearer-token
# Collector API key for authenticating edge signal ingestion
COLLECTOR_API_KEY=replace-with-strong-collector-ingest-key

# --- Network & CORS ---
# JSON array of origins permitted to make cross-origin requests to Backend
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000

# --- Collector Daemon ---
LOCAL_AGENT_HOST=0.0.0.0
LOCAL_AGENT_PORT=8001
COLLECTOR_BIND_IP=127.0.0.1
COLLECTOR_PORT=8001
# Local mock vs hardware adapter (set false for real SDR / WiFi hardware)
MOCK_HARDWARE=true

# --- Frontend (Next.js) ---
# Public browser-facing API URL (used by browser client requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser bearer token for API calls (leave empty if using session login / cookie)
NEXT_PUBLIC_API_AUTH_TOKEN=replace-with-strong-api-bearer-token
# Local collector agent token for direct client-to-collector control
NEXT_PUBLIC_LOCAL_COLLECTOR_TOKEN=replace-with-strong-collector-token
# Internal container network backend URL (used by Next.js server-side rewrites)
INTERNAL_API_URL=http://backend:8000
FRONTEND_BIND_IP=0.0.0.0
FRONTEND_PORT=3000
