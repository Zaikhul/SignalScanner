# ==============================================================================
# PEMINDAI AREA - BACKEND CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env pada direktori backend:
# cp .env.example .env
# atau pada Windows PowerShell:
# Copy-Item .env.example .env

# --- APLIKASI & METADATA ---
PROJECT_NAME="Pemindai Area - Signal Scanner API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- KEAMANAN & PRIVASI (HMAC PSEUDONYMIZATION) ---
# Kunci rahasia untuk tanda tangan perangkat dan validasi
SECRET_KEY="secret-signal-scanner-key-hmac-salt-change-in-prod"

# Salt unik per-organisasi / tenant untuk pseudonimisasi BSSID & MAC address
TENANT_SALT="tenant_default_salt_2026"

# --- CORS ORIGINS ---
# Daftar origin web frontend yang diizinkan (format JSON Array)
ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]'

# --- DATABASE PERSISTENCE ---
# Opsi 1: SQLite Async (Default untuk local dev mandiri tanpa install PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./signal_scanner.db"

# Opsi 2: PostgreSQL + TimescaleDB (Produksi / Docker Compose)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/SignalScanner"

# --- REAL-TIME STREAM ENGINE ---
# Opsi backend stream: "memory" (in-process queue tanpa Redis) atau "redis" (multi-node)
STREAM_BACKEND="memory"

# URL Redis (diperlukan hanya jika STREAM_BACKEND="redis")
# REDIS_URL="redis://localhost:6379/0"

# --- PARAMETER PENGOLAHAN SINYAL (SIGNAL PROCESSING) ---
# Koefisien Exponential Moving Average (0.0 < alpha <= 1.0)
# Nilai lebih kecil = grafik lebih halus; nilai lebih besar = respon lebih cepat
DEFAULT_EMA_ALPHA=0.35

# Estimasi baseline noise floor default WiFi / BLE (dBm)
DEFAULT_NOISE_FLOOR_DBM=-95.0

# Estimasi baseline noise floor default Radio SDR (dBFS)
DEFAULT_NOISE_FLOOR_DBFS=-100.0
